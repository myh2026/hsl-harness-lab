// ============================================================================
// franxagent/types/messages.hsl — 消息 / 工具请求 / 工具结果 / 提案（契约层）
// ============================================================================
// FranxAgent 原架构对应：agent.py 的 messages 数组（OpenAI 四角色流 +
// tool_calls 结构）与 USER_GUIDE 的 `tools` 单入口协议。
// HSL 侧：封闭枚举承载工具词汇；提案（Proposal）是 write 工具
// proposal-review-overwrite 模式的一等值。
// v6：Message 增加 pair 字段——assistant 工具回合携带分号连接的
// tool_call id 集，tool 结果携带单个 tool_call_id（原版 tool_call_id
// 配对身份的扁平化身，供孤儿清理与上下文压缩的安全切割使用）。
// ============================================================================

#[derive(Debug, Clone)]
export struct Message {
    role: String,
    content: String,
    /// 配对身份（OpenAI tool_call_id 的扁平投影）：
    /// - assistant 工具回合：分号连接的 call_id 集（"call_1;call_2"）；
    /// - tool 结果：单个 call_id；
    /// - 其余角色：空串。
    pair: String,
}

impl Message {
    fn system(text: String) -> Message {
        Message { role: String::from("system"), content: text, pair: String::from("") }
    }

    fn user(text: String) -> Message {
        Message { role: String::from("user"), content: text, pair: String::from("") }
    }

    fn assistant(text: String) -> Message {
        Message { role: String::from("assistant"), content: text, pair: String::from("") }
    }

    fn tool(text: String) -> Message {
        Message { role: String::from("tool"), content: text, pair: String::from("") }
    }

    /// assistant 工具回合（pair = 分号连接的 call_id 集）。
    fn assistant_tools(text: String, pair: String) -> Message {
        Message { role: String::from("assistant"), content: text, pair }
    }

    /// tool 结果（pair = call_id，与发起方配对）。
    fn tool_result(text: String, call_id: String) -> Message {
        Message { role: String::from("tool"), content: text, pair: call_id }
    }

    /// 同内容换配对身份（孤儿清理：剥离失配 tool_calls 但保留正文）。
    fn with_pair(self, pair: String) -> Message {
        Message { role: self.role, content: self.content, pair }
    }

    /// 本条消息携带的 call_id 集（空 → 空表）。
    fn pair_ids(self) -> Vec<String> {
        let mut out: Vec<String> = Vec::new();
        if self.pair.len() > 0 {
            for id in self.pair.split(String::from(";")) {
                if id.len() > 0 {
                    out.push(id);
                }
            }
        }
        out
    }
}

/// 工具词汇：`tools` 单入口协议的内层工具（封闭枚举，S6）。
/// 与 FranxAgent 内建六件套对齐：read / write / command / search /
/// time / add_skill；另设 Mcp 外部转发臂（"server/tool" 形态，
/// 对应 loader.tools 的 "/" 分支）。
#[derive(Debug, Clone)]
export enum ToolCall {
    Read { path: String },
    Write { path: String, content: String, mode: String, start_line: u32, end_line: u32 },
    Command { command: String },
    Search { query: String, max_results: u32 },
    Time,
    AddSkill { name: String, content: String },
    Mcp { server: String, tool: String, arguments: String },
}

impl ToolCall {
    /// 工具名（协议解析 / 审计共用）。
    fn name(self) -> String {
        match self {
            ToolCall::Read { path: _ } => String::from("read"),
            ToolCall::Write { path: _, content: _, mode: _, start_line: _, end_line: _ } => String::from("write"),
            ToolCall::Command { command: _ } => String::from("command"),
            ToolCall::Search { query: _, max_results: _ } => String::from("search"),
            ToolCall::Time => String::from("time"),
            ToolCall::AddSkill { name: _, content: _ } => String::from("add_skill"),
            ToolCall::Mcp { server, tool, arguments: _ } => format!("{}/{}", server, tool),
        }
    }
}

/// 工具请求（模型的一次 tool_call；纠偏后的规范化形态）。
/// FranxAgent 纠偏语义：模型直接调用内建工具名时自动包装为 tools 协议。
#[derive(Debug, Clone)]
export struct ToolRequest {
    id: String,
    tool: ToolCall,
}

/// 工具执行结果（软失败反馈模型；不终止会话）。
#[derive(Debug, Clone)]
export struct ToolOutcome {
    call_id: String,
    tool: String,
    ok: bool,
    output: String,
    proposal: Option<Proposal>,
}

impl ToolOutcome {
    /// 回填转录的 tool 消息（OpenAI 风格 tool 角色 + 配对身份）。
    fn to_message(self) -> Message {
        let mut text = String::from("[tool ");
        text.push_str(self.tool.as_str());
        text.push_str("]");
        if self.ok {
            text.push_str(" ok\n");
        } else {
            text.push_str(" FAILED\n");
        }
        text.push_str(self.output.as_str());
        Message::tool_result(text, self.call_id)
    }
}

/// write 提案（proposal-review-overwrite 模式的一等值）。
/// v5.0.0 核心语义：write 不落盘，产出完整文件内容提案，
/// 审查闸门批准后才写盘并回填模型。
#[derive(Debug, Clone)]
export struct Proposal {
    path: String,
    mode: String,
    before: String,
    after: String,
}

impl Proposal {
    /// 提案渲染（审查面板的文本化身：前后对照）。
    fn render(self) -> String {
        format!(
            "proposal {} ({}):\n--- before ({} chars) ---\n{}\n--- after ({} chars) ---\n{}",
            self.path, self.mode, self.before.len(), self.before, self.after.len(), self.after
        )
    }
}

/// 会话轮词汇（edge on Guard 用，G5）。
#[derive(Debug, Clone)]
export enum Turn {
    ToolCalled,
    Observed,
    ProposalReady,
    Remembered,
    ContextCompressed,
    TaskTriggered,
    Replied,
    BudgetExhausted,
}
