// ============================================================================
// dsh/tools/todo.hsl — todo_write（tool-todo 的整表写入 + 投影）
// ============================================================================
// deepseek-harness 原架构对应：packages/todo/tool-todo——「结构化任务清单：
// 整表替换、会话所有权、todos 投影注入上下文」。HSL 侧：校验
// （内容非空唯一 / 状态枚举 / 单 in_progress 纪律——allowParallel 可放宽）
// 与计数文案逐字对齐原版；整表写回 RunState.todos（会话所有权投影）。
// ============================================================================

import { ToolResult, TodoItem } from "../types/messages.hsl";
import { Policy } from "../types/state.hsl";

/// todo_write 校验 + 观察文案（整表替换语义）。
/// 返回 (ToolResult, 新表)；校验失败时表保持原值（调用方丢弃新表即可）。
export fn todo_write(policy: Policy, todos: Vec<TodoItem>) -> Result<ToolResult, String> {
    if todos.len() == 0 {
        return Err(String::from("todos must be a non-empty array"));
    }
    let mut active: u32 = 0;
    let mut seen: Vec<String> = Vec::new();
    for item in todos.clone() {
        let content = item.content.trim();
        if content.len() == 0 {
            return Err(String::from("todo content must be a non-empty string"));
        }
        if seen.contains(content.clone()) {
            return Err(format!("todo content must be unique: \"{}\"", content));
        }
        seen.push(content);
        if item.status != String::from("pending") && item.status != String::from("in_progress") && item.status != String::from("completed") {
            return Err(format!("invalid todo status \"{}\" (pending | in_progress | completed)", item.status));
        }
        if item.status == String::from("in_progress") {
            active += 1;
        }
    }
    if active > 1 && policy.todo_allow_parallel == false {
        return Err(format!("invalid todos: at most one task may be in_progress (got {})", active));
    }
    let counts = count_all(todos.clone());
    Ok(ToolResult {
        call: String::from("todo_write"),
        ok: true,
        output: format!("Updated todo list: {} pending, {} in progress, {} completed.", counts[0], counts[1], counts[2]),
        duration_ms: 0,
    })
}

/// todos 投影渲染（注入上下文的快照面）。
export fn render_todos(todos: Vec<TodoItem>) -> String {
    let mut out = String::from("");
    let mut idx: u32 = 0;
    for item in todos {
        idx += 1;
        out.push_str(format!("{}. [{}] {}\n", idx, item.status, item.content).as_str());
    }
    out.trim_end()
}

/// 三态计数。
export fn count_all(todos: Vec<TodoItem>) -> Vec<u32> {
    let mut pending: u32 = 0;
    let mut in_progress: u32 = 0;
    let mut completed: u32 = 0;
    for item in todos {
        if item.status == String::from("pending") {
            pending += 1;
        } else if item.status == String::from("in_progress") {
            in_progress += 1;
        } else if item.status == String::from("completed") {
            completed += 1;
        }
    }
    vec![pending, in_progress, completed]
}
