// ============================================================================
// dsh/tools/shell.hsl — bash 工具（首词白名单 + 超时 + 输出封顶）
// ============================================================================
// deepseek-harness 原架构对应：shell/sandbox 包——命令执行受沙盒约束。
// HSL 侧：#[capability(process_spawn)] 编译期能力 + $host.shell 运行时
// 执行（白名单判定在注册表守卫层，此处只做效应与归一）。
// ============================================================================

import { ToolResult } from "../types/messages.hsl";
import { Policy } from "../types/state.hsl";
import { cap_chars } from "./workspace.hsl";

/// bash 工具：执行命令并归一输出（stdout/stderr 合并 + 封顶）。
/// 超时预算 = timeout-policy 下传宿主的协作截止线
/// （min(policy.tool_timeout_ms, 60000)；宿主真超时杀进程）。
#[capability(process_spawn)]
export fn run_bash(policy: Policy, command: String) -> Result<ToolResult, String> {
    let budget = policy.tool_timeout_ms.min(60_000);
    let r = native typescript {
        const out = await $host.shell.run(command, { timeoutMs: budget });
        return { ok: out.ok, code: out.code, stdout: out.stdout, stderr: out.stderr };
    };
    let mut combined = String::from("");
    if r.stdout.len() > 0 {
        combined.push_str(r.stdout.as_str());
    }
    if r.stderr.len() > 0 {
        if combined.len() > 0 {
            combined.push_str("\n");
        }
        combined.push_str("[stderr]\n");
        combined.push_str(r.stderr.as_str());
    }
    if combined.len() == 0 {
        combined.push_str(format!("(no output, exit {})", r.code).as_str());
    }
    let capped = cap_chars(combined, policy.max_output_chars);
    Ok(ToolResult {
        call: format!("bash {}", command),
        ok: r.ok,
        output: capped,
        duration_ms: 0,
    })
}
