            String::from("平平仄仄平平仄"),
            String::from("仄仄平平仄仄平"),
        ],
        rhyme_lines: vec![0, 1, 3],
        syllables_per_line: 7,
        syl_spec: vec![SylSpec::exact(7), SylSpec::exact(7), SylSpec::exact(7), SylSpec::exact(7)],
        constraints: Vec::new(),
