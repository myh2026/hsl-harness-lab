// ============================================================================
// stanzaweaver/prosody/templates.hsl — 格律模板注册表（五语言全量）
// ============================================================================
// StanzaWeaver 原架构对应：src/templates/{zh,en,fr,it,la}.py 的全部 17 个
// 模板定义（register 键 → PoetryTemplate 子类）与 templates/__init__.py 的
// list_dicts 序列化形状（key/name/language/lines/syllables_per_line/
// syllable_constraints/display_name）。
//
// Task 6-c 移植口径：
//   - 逐模板移植原版数据：name / language / lines / syllables_per_line
//     （syl_spec，定值或区间）/ get_syllable_constraints（constraints 逐行
//     逐位）/ rule_description（注入提示词）；validate_full 的押韵要求数据化
//     为 rhyme_groups（标签 + 行号组）、整行叠句数据化为 refrain_groups。
//   - 原版键用下划线（zh_wujue）；HSL 侧沿用连字符键（zh-wujue，与既有
//     复现及 web 适配层约定一致），en-couplet 对应原版 en_heroic_couplet。
//   - 兼容字段（chars_per_line / tone_pattern / rhyme_lines /
//     syllables_per_line）保住现行 zh/en 校验路径 —— zh 五绝/七绝/律诗沿用
//     HSL 侧逐字平仄谱（比原版「二四六分明」更强的判定，已披露）；相见欢
//     词谱按原版逐位 constraints 走通用路径。
//   - 原版 validate_full 的跨行专属规则（叠句词序细节、维拉内拉 A/B 互异、
//     意语第 10 音节重读、拉丁音步扫描、canzone 韵脚上限等）未逐条移植，
//     见 README 偏差披露。
// ============================================================================

import { MeterTemplate, SylSpec } from "../types/poem.hsl";
import { SylConstraint } from "../types/syllable.hsl";
import { WeaverError } from "../types/errors.hsl";

/// 语言显示名（原版 _LANGUAGE_LABELS —— list_dicts 的 display_name 组成部分）。
fn language_label(lang: String) -> String {
    if lang == String::from("zh") {
        String::from("汉语")
    } else if lang == String::from("en") {
        String::from("英语")
    } else if lang == String::from("it") {
        String::from("意大利语")
    } else if lang == String::from("fr") {
        String::from("法语")
    } else if lang == String::from("la") {
        String::from("古典拉丁语")
    } else {
        lang
    }
}

/// 模板显示名（原版 list_dicts 的 display_name = "name（语言）"）。
export fn display_name(t: MeterTemplate) -> String {
    format!("{}（{}）", t.name, language_label(t.language.clone()))
}

// ── zh：五言绝句 / 七言绝句 / 五言律诗 / 七言律诗 / 相见欢 ──

/// zh_wujue 五言绝句：4 行 5 字，二四字定平仄，偶句平声韵。
fn tpl_zh_wujue() -> MeterTemplate {
    MeterTemplate {
        key: String::from("zh-wujue"),
        name: String::from("五言绝句"),
        language: String::from("zh"),
        line_count: 4,
        chars_per_line: 5,
        tone_pattern: vec![
            String::from("仄仄平平仄"),
            String::from("平平仄仄平"),
            String::from("平平平仄仄"),
            String::from("仄仄仄平平"),
        ],
        rhyme_lines: vec![1, 3],
        syllables_per_line: 5,
        syl_spec: vec![SylSpec::exact(5), SylSpec::exact(5), SylSpec::exact(5), SylSpec::exact(5)],
        constraints: Vec::new(),
        rhyme_groups: vec![(String::from("押韵(二四行)"), vec![1, 3])],
        refrain_groups: Vec::new(),
        rule_description: String::from("格律规则：每句第2、4字平仄相间；每联上下句第2、4字平仄相对；下一联首句与上一联对句第2、4字平仄相粘；偶数句押平声韵，首句尾字可押韵(平)可不押韵(仄)；忌三平尾、孤平。"),
    }
}

