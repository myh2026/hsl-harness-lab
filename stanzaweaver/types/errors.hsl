// ============================================================================
// stanzaweaver/types/errors.hsl — 错误层：模型 / 校验 / 顶层通道
// ============================================================================
// StanzaWeaver 原架构对应：agents/base.py 的 API 异常 + pipeline 的
// 预算控制。HSL 侧：ModelError / WeaverError + From（格律违规不在此层——
// 那是 ToolOutcome 软反馈，走 ReAct 循环自纠，不终止流水线）。
// ============================================================================

/// 模型提供方错误。
#[derive(Debug, Clone)]
export struct ModelError {
    code: u32,
    message: String,
}

impl ModelError {
    fn new(code: u32, message: String) -> ModelError {
        ModelError { code, message }
    }
}

/// 顶层流水线错误。
#[derive(Debug, Clone)]
export struct WeaverError {
    kind: String,
    message: String,
}

impl WeaverError {
    fn new(kind: String, message: String) -> WeaverError {
        WeaverError { kind, message }
    }
}

// ? 自动包装：ModelError → WeaverError
impl From<ModelError> for WeaverError {
    fn from(src: ModelError) -> WeaverError {
        WeaverError {
            kind: String::from("model"),
            message: format!("model {}: {}", src.code, src.message),
        }
    }
}

// ? 自动包装：String（parse 错误）→ WeaverError
impl From<String> for WeaverError {
    fn from(src: String) -> WeaverError {
        WeaverError { kind: String::from("parse"), message: src }
    }
}
