// ============================================================================
// stanzaweaver/knowledge/importer.hsl — 词库数据集导入（捆绑样例）
// ============================================================================
// StanzaWeaver 原架构对应：src/knowledge/importer.py 的 import_all ——
// 首次运行自动执行：下载数据集 → 解析为 Word 列表 → 写入 SQLite；
// 同一数据集已导入时跳过（meta 表记录版本）。
//
// HSL 侧口径（如实披露）：
//   - zh 主数据集 CC-CEDICT 文本格式逐行解析器【完整移植】：
//     `漢字 简体 [pin1yin1] /释义/` → 多读音独立成条 + 拼音拆解（声母/韵腹/
//     韵尾/平仄，复用 prosody/chinese.hsl 共享表）+ 释义提取（首个 /.../ 段，
//     "/" → "; "，截 120 字符）；
//   - fr 数据集 Lexique382 TSV 解析器【样例级移植】：表头探测
//     ortho/nbsyl(nbsyll)/phon 列 → 词形去重 → 法语音节切分对齐 nbsyl；
//   - 网络下载（CEDICT 全量 / CMUdict / Lexique 全量 / GLAW-IT / Lewis &
//     Short）如实披露为范围外：HSL 剑本离线运行，数据集改为捆绑样例文件，
//     由运行前部署到工作区 datasets/（见 run-tests.sh）；样例缺失时镜像
//     原版网络失败的降级路径（记日志、返回、不置 meta）。
//   - en/it/la 三个数据集未捆绑样例（import_all 镜像跳过日志）。
// ============================================================================

import { Word } from "../types/word.hsl";
import { Syllable } from "../types/syllable.hsl";
import { parse_pinyin, is_valid_pinyin_token } from "../prosody/chinese.hsl";
import { fr_syllabify_word } from "../prosody/french.hsl";
import { WordVault } from "./vocab.hsl";

/// 导入全部语言词库（幂等，已导入的数据集自动跳过 —— 原版 import_all）。
/// 返回导入后的词库（函数式更新；total > 0 时落盘并记录 meta）。
export fn import_all(vault: WordVault) -> WordVault {
    let v_zh = import_chinese(vault.clone());
    let v_fr = import_french(v_zh.clone());
    // en@CMUdict / it@GLAW-IT / la@Lewis-Short：网络数据集，范围外（未捆绑样例）
    println!("[en@CMUdict] 样例未捆绑，跳过（原版经网络下载，范围外）");
    println!("[it@GLAW-IT] 样例未捆绑，跳过（原版经网络下载，范围外）");
    println!("[la@Lewis-Short] 样例未捆绑，跳过（原版经网络下载，范围外）");
    v_fr
}

/// 读工作区数据集文件（$host.fs 路径监狱内；缺失 → 空串，镜像网络失败）。
fn read_dataset(path: String) -> String {
    native typescript {
        try {
            return $host.fs.read(path);
        } catch (e) {
            return "";
        }
    }
}

// ── zh：CC-CEDICT 文本格式 ──

/// 导入 CC-CEDICT 样例（原版 _import_chinese：幂等 + 逐行解析 + 批量入库）。
fn import_chinese(vault: WordVault) -> WordVault {
    if vault.clone().has_dataset(String::from("zh"), String::from("CC-CEDICT-sample")) {
        println!("[zh] 已有数据，跳过");
        return vault;
    }
    let text = read_dataset(String::from("datasets/cedict-sample.txt"));
    if text.len() == 0 {
        println!("[zh] CC-CEDICT error: 样例缺失（datasets/cedict-sample.txt；原版经网络下载，范围外）");
        return vault;
    }
    let mut batch: Vec<Word> = Vec::new();
    for line in text.lines() {
        let t = line.trim();
        if t.len() == 0 || t.starts_with("#") {
            continue;
        }
        batch.append(parse_cedict_line(t.clone()));
    }
    let total = batch.len();
    if total > 0 {
        let v = vault.clone().with_words(batch);
        let v2 = v.with_dataset(String::from("zh"), String::from("CC-CEDICT-sample"));
        v2.clone().save();
        println!("[zh@CC-CEDICT] {}", total);
        return v2;
    }
    println!("[zh@CC-CEDICT] 0");
    vault
}

/// CEDICT 行拆三段：`傳統 简体 rest`（原版 line.split(" ", 2)）。
/// 无第二段 → (line, "", "")，调用方按 len(parts) < 2 跳过。
fn cedict_parts(line: String) -> (String, String, String) {
    let toks = line.split(" ");
    if toks.len() < 2 {
        return (line, String::from(""), String::from(""));
    }
    let trad = toks[0].clone();
    let simplified = toks[1].clone();
    let head_len = trad.len() + 1 + simplified.len();
    let rest = if line.len() > head_len {
        let chars = line.chars();
        chars.skip(head_len + 1).collect::<String>()
    } else {
        String::from("")
    };
    (trad, simplified, rest)
}

/// 提取全部拼音括号组（原版逐字符等价于正则 findall：取 "[" 到下一个 "]"
/// 组内不含 "[" "]" "/" 且非空；失败前移一位重试（镜像正则推进））。
fn extract_bracket_groups(rest: String) -> Vec<String> {
    let mut out: Vec<String> = Vec::new();
    let chars = rest.chars();
    let n = chars.len();
    let mut i: u32 = 0;
    while i < n {
        let ch = chars.get(i).unwrap_or(String::from(""));
        if ch == String::from("[") {
            let mut j = i + 1;
            let mut ok = true;
            let mut closed = false;
            let mut inner = String::new();
            while j < n {
                let cj = chars.get(j).unwrap_or(String::from(""));
                if cj == String::from("]") {
                    closed = true;
                    break;
                }
                if cj == String::from("[") || cj == String::from("/") {
                    ok = false;
                }
                inner.push_str(cj.as_str());
                j += 1;
            }
            if closed && ok && inner.len() > 0 {
                out.push(inner);
                i = j + 1;
            } else {
                i += 1;
            }
        } else {
            i += 1;
        }
    }
    out
}

/// 从 from 起找目标字符的下标。
fn find_char(s: String, target: String, from: u32) -> Option<u32> {
    let chars = s.chars();
    let n = chars.len();
    let mut i = from;
    while i < n {
        if chars.get(i).unwrap_or(String::from("")) == target {
            return Option::Some(i);
        }
        i += 1;
    }
    Option::None
}

/// 提取释义（原版 re.search(r"/(.+?)/")：首个 /.../ 段；"/" → "; "，截 120 字符）。
fn extract_cedict_meaning(rest: String) -> String {
    let chars = rest.chars();
    match find_char(rest.clone(), String::from("/"), 0) {
        Option::Some(i) => {
            match find_char(rest.clone(), String::from("/"), i + 1) {
                Option::Some(j) => {
                    if j > i + 1 {
                        let raw = chars.skip(i + 1).take(j - i - 1).collect::<String>();
                        let swapped = raw.replace(String::from("/"), String::from("; "));
                        let swapped_chars = swapped.chars();
                        swapped_chars.take(120).collect::<String>()
                    } else {
                        String::from("")
                    }
                },
                Option::None => String::from(""),
            }
        },
        Option::None => String::from(""),
    }
}

/// 解析一条 CEDICT 行 → 词条列表（多读音独立成条，读法去重）。
export fn parse_cedict_line(line: String) -> Vec<Word> {
    let (trad, simplified, rest) = cedict_parts(line.clone());
    let _ = trad; // 传统字列不使用（原版只取 simplified）
    if simplified.len() == 0 {
        return Vec::new();
    }
    let groups = extract_bracket_groups(rest.clone());
    if groups.len() == 0 {
        return Vec::new();
    }
    let meaning = extract_cedict_meaning(rest.clone());
    // 每组按空白切 token；组内 token 全部合法才算有效读音
    let mut valid_prons: Vec<Vec<String>> = Vec::new();
    for g in groups {
        let toks = g.split_whitespace();
        let mut all_ok = toks.len() > 0;
        for t in toks.clone() {
            if is_valid_pinyin_token(t) == false {
                all_ok = false;
            }
        }
        if all_ok {
            valid_prons.push(toks);
        }
    }
    if valid_prons.len() == 0 {
        return Vec::new();
    }
    let mut out: Vec<Word> = Vec::new();
    let mut seen: Vec<Vec<String>> = Vec::new();
    for toks in valid_prons {
        if seen.contains(toks.clone()) {
            continue;
        }
        seen.push(toks.clone());
        let syls = parse_pinyin(toks);
        out.push(Word {
            text: simplified.clone(),
            language: String::from("zh"),
            syllables: syls,
            meaning: meaning.clone(),
        });
    }
    out
}

// ── fr：Lexique382 TSV ──

/// 未知占位音节（原版 Syllable(nucleus="?")）。
fn unknown_syllable() -> Syllable {
    Syllable {
        onset: String::from(""),
        nucleus: String::from("?"),
        coda: String::from(""),
        tone: String::from(""),
        stress: String::from(""),
        length: String::from(""),
    }
}

/// 导入 Lexique382 样例（原版 _import_french：表头探测 + 词形去重 +
/// 音节切分对齐 nbsyl + phon 作释义）。
fn import_french(vault: WordVault) -> WordVault {
    if vault.clone().has_dataset(String::from("fr"), String::from("Lexique382-sample")) {
        println!("[fr] 已有数据，跳过");
        return vault;
    }
    let text = read_dataset(String::from("datasets/lexique-sample.tsv"));
    if text.len() == 0 {
        println!("[fr] Lexique382 error: 样例缺失（datasets/lexique-sample.tsv；原版经网络下载，范围外）");
        return vault;
    }
    let lines = text.lines();
    if lines.len() < 2 {
        return vault;
    }
    // 表头列探测：ortho / nbsyl|nbsyll / phon（原版取首个命中列）
    let hdr = lines[0].clone();
    let mut wc: Option<u32> = Option::None;
    let mut sc: Option<u32> = Option::None;
    let mut pc: Option<u32> = Option::None;
    for pair in hdr.split("\t").enumerate() {
        let h = pair[1].clone().to_lowercase();
        if h == String::from("ortho") && wc.is_none() {
            wc = Option::Some(pair[0]);
        }
        if (h == String::from("nbsyl") || h == String::from("nbsyll")) && sc.is_none() {
            sc = Option::Some(pair[0]);
        }
        if h == String::from("phon") && pc.is_none() {
            pc = Option::Some(pair[0]);
        }
    }
    let mut batch: Vec<Word> = Vec::new();
    let mut seen: Vec<String> = Vec::new();
    for line in lines.clone().skip(1) {
        let cols = line.split("\t");
        let raw_w = match wc {
            Option::Some(idx) => cols.get(idx).unwrap_or(String::from("")),
            Option::None => String::from(""),
        };
        let w = raw_w.trim().to_lowercase();
        if w.len() == 0 || seen.contains(w.clone()) {
            continue;
        }
        seen.push(w.clone());
        // nbsyl（缺列/解析失败 → 1）
        let mut n: u32 = 1;
        if sc.is_some() {
            let sci = sc.unwrap_or(0);
            let raw_n = cols.get(sci).unwrap_or(String::from("1"));
            n = raw_n.trim().parse::<u32>().unwrap_or(1);
        }
        let phon = match pc {
            Option::Some(idx) => cols.get(idx).unwrap_or(String::from("")),
            Option::None => String::from(""),
        };
        // 音节切分并对齐 nbsyl（原版：空 → 占位；不足补占位；超出截断）
        let mut syls = fr_syllabify_word(w.clone());
        if syls.len() == 0 {
            let mut i: u32 = 0;
            while i < n {
                syls.push(unknown_syllable());
                i += 1;
            }
        } else {
            if syls.len() < n {
                while syls.len() < n {
                    syls.push(unknown_syllable());
                }
            } else {
                if syls.len() > n {
                    syls = syls.take(n);
                }
            }
        }
        batch.push(Word {
            text: w,
            language: String::from("fr"),
            syllables: syls,
            meaning: phon,
        });
    }
    let total = batch.len();
    if total > 0 {
        let v = vault.clone().with_words(batch);
        let v2 = v.with_dataset(String::from("fr"), String::from("Lexique382-sample"));
        v2.clone().save();
        println!("[fr@Lexique382] {}", total);
        return v2;
    }
    println!("[fr@Lexique382] 0");
    vault
}
